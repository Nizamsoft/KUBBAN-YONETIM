rules_version = '2';
// ============================================================================
//  GÜLLÜOĞLU KÜBBAN — Firestore Güvenlik Kuralları
//  Firebase Console > Firestore Database > Rules bölümüne yapıştırın.
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    // Kullanıcının rolünü users/{uid} dokümanından okur
    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        role() == 'admin';
    }

    // --- Kullanıcılar ---
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      // Kullanıcı kendi dokümanını oluşturabilir; kendi rolünü admin yapamaz
      allow create: if isSignedIn() && request.auth.uid == uid
                    && request.resource.data.role in ['user', 'admin'];
      // Kendi profilini güncelleyebilir ama rol değişimini engelle (admin hariç)
      allow update: if isSignedIn() && (
                      isAdmin() ||
                      (request.auth.uid == uid &&
                       request.resource.data.role == resource.data.role)
                    );
      allow delete: if isAdmin();
    }

    // --- Gün Sonu Kayıtları: herkes okur, YALNIZCA yetkili (admin) düzenler/siler ---
    match /dayEndRecords/{id} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // --- Diğer operasyonel koleksiyonlar: giriş yapan kullanıcılar ---
    match /accounts/{id}         { allow read, write: if isSignedIn(); }
    match /currentMovements/{id} { allow read, write: if isSignedIn(); }
    match /bankTransactions/{id} { allow read, write: if isSignedIn(); }
    match /cashflowItems/{id}    { allow read, write: if isSignedIn(); }
  }
}
